{
  "name": "pgnoc-ti-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "lint": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@lucide/vue": "^1.31.0",
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.1",
    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.6",
    "prettier": "^3.9.6",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plugin-webfont-dl": "^3.13.1",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.3.8"
